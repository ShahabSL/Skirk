#!/bin/sh /etc/rc.common

# Copy this file to /etc/init.d/skirk. Keep the profile in /etc/skirk/client.skirk,
# never in this script or in a --config command-line value.
# shellcheck disable=SC2034 # rc.common reads these variables when sourcing the script.
START=95
STOP=10
USE_PROCD=1

SKIRK_BIN="${SKIRK_BIN:-/usr/bin/skirk}"
SKIRK_PROFILE="${SKIRK_PROFILE:-/etc/skirk/client.skirk}"
SKIRK_LISTEN="${SKIRK_LISTEN:-127.0.0.1:18080}"
SKIRK_CLIENT_ID="${SKIRK_CLIENT_ID:-}"

start_service() {
    if [ ! -x "$SKIRK_BIN" ]; then
        logger -t skirk "Executable not found: $SKIRK_BIN"
        return 1
    fi
    if [ ! -r "$SKIRK_PROFILE" ]; then
        logger -t skirk "Client profile not readable: $SKIRK_PROFILE"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$SKIRK_BIN" serve-client \
        --config "$SKIRK_PROFILE" --listen "$SKIRK_LISTEN"
    if [ -n "$SKIRK_CLIENT_ID" ]; then
        procd_append_param command --client-id "$SKIRK_CLIENT_ID"
    fi
    procd_set_param file "$SKIRK_PROFILE"
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
